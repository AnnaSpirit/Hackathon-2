# === 📦 Dépendances Node.js ===
# === 📦 Node.js dependencies ===
node_modules/


# === 🔐 Fichiers sensibles comme les clés API ===
# === 🔐 Sensitive files like API keys ===
.env


# === 🐞 Fichiers de log générés lors d'erreurs ou du debug ===
# === 🐞 Log files generated from errors or debugging ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# === ⚙️ Dossiers de configuration des éditeurs de code ===
# === ⚙️ Code editor config folders ===
.vscode/
.idea/


# === 🛠️ Fichiers système inutiles (macOS/Windows) ===
# === 🛠️ Useless system files (macOS/Windows) ===
.DS_Store
Thumbs.db


# === 🔨 Fichiers générés après compilation (React/JS) ===
# === 🔨 Build files generated by React or JS bundlers ===
build/
dist/


# === 📷 Fichiers de cache ou temporaires ===
# === 📷 Cache or temporary files ===
.cache/
*.tmp
*.swp


# === 🤖 Fichiers liés à Bun ou autres outils éventuels ===
# === 🤖 Bun-related or other tool-specific files ===
.bun/


# === 🧪 Résultats de tests ou fichiers de couverture ===
# === 🧪 Test results or coverage data ===
coverage/
